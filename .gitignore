# build directories
/build.*/
/builds
/.fakeroot.*

# automatically downloaded source files
/sources/

# prebuild target binarys to provide
/target/

# mkpkg temp
mkpkg-temp

# options
/.libreelec

# private working directory
/.work/

# dedicated filesystem
/lost+found/

# symlinks...
/sources
/.work

# ccache
/.ccache/

# backup files
*.orig

# crap
.DS_Store
.directory

# ignore git repos from update scripts
tools/mkpkg/*.git

# ignore old linux configs
projects/**/*.old

# ROCKNIX
/.rocknix
/.cache
/.doc_cache
/.env
/.es_cache
/.config

# SDM845/beryllium: proprietary per-device firmware (extract from your own device's
# MIUI/vendor or a pmOS install; NOT redistributable - do not commit).
# Narrowed to the beryllium/ blob dir so the extraction README beside it stays tracked.
# (The a630 GPU microcode under qcom/ IS redistributable - from linux-firmware,
#  LICENSE.qcom - and is committed.)
projects/ROCKNIX/devices/SDM845/filesystem/usr/lib/kernel-overlays/base/lib/firmware/qcom/sdm845/Xiaomi/beryllium/

# Build artifacts / scratch (large images, never commit)
/flash/

# Parked upstream patches disabled in this fork (kept locally as reference)
projects/ROCKNIX/devices/SDM845/patches/linux/_disabled_for_fork/

# SDM845/beryllium: proprietary TAS2559 speaker-amp firmware (extract from your
# device's vendor partition; NOT redistributable). tas2559_uCDSP.bin is the DSP
# blob the driver loads; the .ftcfg are the L/R speaker tuning configs.
projects/ROCKNIX/devices/SDM845/filesystem/usr/lib/kernel-overlays/base/lib/firmware/tas2559_*
